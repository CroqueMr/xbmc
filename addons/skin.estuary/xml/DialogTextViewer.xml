			<visible>String.IsEmpty(Window.Property(CB1.LldvDetailLabels)) + Integer.IsGreater(Container(5).NumPages,1)</visible>
		</control>
		<control type="group">
			<visible>!String.IsEmpty(Window.Property(CB1.LldvDetailLabels))</visible>
